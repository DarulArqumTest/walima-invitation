# =============================================================================
#  Environment variables — SERVER-SIDE ONLY. None of these are served to the browser.
#  Copy to .env for local dev (never commit .env), and set them in
#  Vercel -> Project -> Settings -> Environment Variables for production.
# =============================================================================

# --- Vercel Postgres ---------------------------------------------------------
# DO NOT set these by hand. When you attach a Postgres store to the project in the
# Vercel dashboard, Vercel injects POSTGRES_URL and the other POSTGRES_* variables
# automatically. They are shown here only so you know they exist.
#   POSTGRES_URL=            (injected by Vercel)
#   POSTGRES_PRISMA_URL=     (injected by Vercel)
#   POSTGRES_URL_NON_POOLING=(injected by Vercel)

# --- You must set these two by hand ------------------------------------------

# Password for the admin panel at /admin. Use a long, random value.
ADMIN_PASSWORD=

# Secret used to sign session cookies (HMAC-SHA256). Generate a strong one, e.g.:
#   openssl rand -hex 32
SESSION_SECRET=
